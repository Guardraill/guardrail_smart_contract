/// @title LibComplianceStorage
/// @notice Diamond storage library for the ComplianceDiamond.
///         All state that the ComplianceRegistry previously held in
///         regular contract storage slots now lives here, isolated
///         inside a pseudo-random keccak256 slot that cannot collide
///         with LibDiamond's own storage or any future facet.
///
/// @dev HOW DIAMOND STORAGE WORKS
///      In a normal contract, state variables occupy sequential storage
///      slots starting at slot 0. In a diamond, ALL facets share the
///      same storage (the diamond proxy). If two facets both declared a
///      uint256 at slot 0, they would collide and corrupt each other.
///
///      The solution is to store ALL application state inside a single
///      struct, and point that struct at a slot derived from a unique
///      string hash. The hash is so large that accidental collision
///      with any other library is cryptographically impossible.
///
///      Every facet accesses state through LibComplianceStorage.layout()
///      instead of declaring its own state variables. This guarantees
///      all facets read and write the same underlying storage positions.
library LibComplianceStorage {

    // ─── Storage Position ─────────────────────────────────────────────────────
    // keccak256("guardrail.compliance.storage.v1")
    // Changing this string creates a completely separate storage namespace.
    // Never change it after deployment — doing so would orphan all existing data.
    bytes32 internal constant COMPLIANCE_STORAGE_POSITION =
        keccak256("guardrail.compliance.storage.v1");

    // ─── Structs (mirrors ICompliance exactly) ────────────────────────────────

    /// @notice Full KYC/AML profile for a single investor wallet
    struct InvestorData {
        bool isVerified;       // has passed KYC
        bool isAccredited;     // meets accreditation threshold
        bool isFrozen;         // blocked without revoking KYC
        uint64 validUntil;     // unix timestamp — 0 = never expires
        bytes32 jurisdiction;  // keccak256 of ISO country code e.g. keccak256("NG")
        bytes32 externalRef;   // off-chain KYC provider reference ID
    }

    /// @notice Per-asset compliance configuration set by the compliance officer
    struct AssetRules {
        bool transfersEnabled;       // secondary market on/off
        bool subscriptionsEnabled;   // new purchases on/off
        bool redemptionsEnabled;     // redemptions on/off
        bool requiresAccreditation;  // accredited investors only
        uint256 minInvestment;       // minimum token amount per purchase (wei)
        uint256 maxInvestorBalance;  // maximum tokens any wallet may hold (wei)
    }

    // ─── Storage Layout ───────────────────────────────────────────────────────

    /// @notice The single struct that holds ALL compliance state.
    ///         Adding new fields here is safe — existing fields retain their
    ///         relative positions within the struct.
    struct Layout {
        /// @dev Address of the platform's AccessControl contract.
        ///      Used by every facet to verify caller roles before mutating state.
        address accessControl;

        /// @dev KYC/AML profiles keyed by investor wallet address.
        mapping(address investor => InvestorData data) investors;

        /// @dev Per-asset compliance rule sets keyed by token contract address.
        mapping(address asset => AssetRules rules) assetRules;

        /// @dev Per-asset, per-jurisdiction restriction flags.
        ///      restrictedJurisdictions[asset][jurisdiction] = true blocks that
        ///      jurisdiction from interacting with that specific asset.
        mapping(address asset => mapping(bytes32 jurisdiction => bool restricted))
            restrictedJurisdictions;

        /// @dev Tracks whether this diamond has been initialized.
        ///      Guards the ComplianceInit.initialize() function from being
        ///      called a second time after deployment.
        bool initialized;
    }

    // ─── Storage Accessor ─────────────────────────────────────────────────────

    /// @notice Returns a storage pointer to the compliance layout struct.
    ///         Every facet calls this to read or write compliance state.
    ///         The assembly block places the struct at the predetermined slot
    ///         rather than at sequential slot 0.
    function layout() internal pure returns (Layout storage l) {
        bytes32 position = COMPLIANCE_STORAGE_POSITION;
        assembly {
            l.slot := position
        }
    }
}
</file>

