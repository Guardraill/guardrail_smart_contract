// =============================================================================
// IMPORT GUIDE — WHICH CONTRACTS SHOULD IMPORT ProposalEncoder
// =============================================================================
//
// ProposalEncoder is a PURE TOOLING library — it produces no transactions and
// holds no state. It gets embedded by the compiler into whichever file imports
// it. The decision of where to import it follows this rule:
//
// "Import ProposalEncoder wherever governance proposals are CONSTRUCTED,
//  not wherever they are EXECUTED."
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │ IMPORT — Foundry governance scripts                                     │
// │ Path: script/governance/                                                │
// │                                                                         │
// │  GovernanceScript.sol          — base script all governance scripts     │
// │  GrantRoleScript.sol           — onboarding new team members            │
// │  RegisterAssetTypeScript.sol   — adding new asset categories            │
// │  CreateAssetScript.sol         — deploying new tokenized assets         │
// │  UpdateComplianceScript.sol    — KYC batch onboarding                   │
// │  UpdateValuationScript.sol     — price updates from oracle              │
// │  UpgradeContractScript.sol     — UUPS upgrade proposals                 │
// │  EmergencyScript.sol           — pause and emergency withdraw           │
// │                                                                         │
// │  Example usage in a script:                                             │
// │                                                                         │
// │    import {ProposalEncoder} from                                        │
// │        "../src/admin/libraries/ProposalEncoder.sol";                    │
// │                                                                         │
// │    bytes memory data = ProposalEncoder.encodeGrantRole(                 │
// │        Roles.ISSUER_ROLE,                                               │
// │        newIssuerAddress                                                 │
// │    );                                                                   │
// │    uint256 id = multiSig.propose(address(accessControl), data, 0);     │
// └─────────────────────────────────────────────────────────────────────────┘
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │ IMPORT — Foundry test files                                             │
// │ Path: test/                                                             │
// │                                                                         │
// │  MultiSigAdmin.t.sol           — tests all governance flows             │
// │  AccessControl.t.sol           — tests role grant/revoke via multisig   │
// │  Integration.t.sol             — full end-to-end governance tests       │
// │                                                                         │
// │  Example usage in a test:                                               │
// │                                                                         │
// │    bytes memory data = ProposalEncoder.encodeSetAssetRules(             │
// │        address(assetToken),                                             │
// │        ICompliance.AssetRules({                                         │
// │            transfersEnabled: true,                                      │
// │            subscriptionsEnabled: true,                                  │
// │            redemptionsEnabled: true,                                    │
// │            requiresAccreditation: false,                                │
// │            minInvestment: 1e18,                                         │
// │            maxInvestorBalance: 500_000 * 1e18                          │
// │        })                                                               │
// │    );                                                                   │
// │    multiSig.propose(address(compliance), data, 0);                     │
// └─────────────────────────────────────────────────────────────────────────┘
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │ DO NOT IMPORT — Core protocol contracts                                 │
// │                                                                         │
// │  AccessControl.sol       — executes proposals, does not construct them  │
// │  BaseAssetToken.sol      — executes proposals, does not construct them  │
// │  ComplianceRegistry.sol  — executes proposals, does not construct them  │
// │  OracleDataBridge.sol    — executes proposals, does not construct them  │
// │  Treasury.sol            — executes proposals, does not construct them  │
// │  AssetFactory.sol        — executes proposals, does not construct them  │
// │  MultiSigAdmin.sol       — executes proposals, does not construct them  │
// │                                                                         │
// │  These contracts are the TARGETS of proposals. They receive and execute │
// │  the encoded bytes. They have no need to construct bytes themselves.    │
// │  Adding ProposalEncoder imports to core contracts adds unnecessary code │
// │  bloat and increases deployment gas for zero benefit.                   │
// └─────────────────────────────────────────────────────────────────────────┘
</file>

