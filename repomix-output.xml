<file path="script/DeployTestnet.s.sol">
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {Script, console2} from "forge-std/Script.sol";

// ── Admin contracts ────────────────────────────────────────────────────────────
import {AccessControl} from "../src/admin/contracts/AccessControl.sol";

// ── Mock token (testnet only) ──────────────────────────────────────────────────
import {MockUSDC} from "../src/mocks/MockUSDC.sol";


import {ComplianceDiamond} from "../src/compliance/diamond/ComplianceDiamond.sol";
import {DiamondCutFacet} from "../src/compliance/facets/DiamondCutFacet.sol";
import {DiamondLoupeFacet} from "../src/compliance/facets/DiamondLoupeFacet.sol";
import {OwnershipFacet} from "../src/compliance/facets/OwnershipFacet.sol";
import {ComplianceWhitelistFacet} from "../src/compliance/facets/ComplianceWhitelistFacet.sol";
import {ComplianceRulesFacet} from "../src/compliance/facets/ComplianceRulesFacet.sol";
import {ComplianceCheckFacet} from "../src/compliance/facets/ComplianceCheckFacet.sol";
import {ComplianceInit} from "../src/compliance/diamond/ComplianceInit.sol";
import {IDiamondCut} from "../src/compliance/interfaces/IDiamondCut.sol";
import {IDiamondLoupe} from "../src/compliance/interfaces/IDiamondLoupe.sol";
import {LibComplianceStorage} from "../src/compliance/libraries/LibComplianceStorage.sol";

// ── Oracle, Treasury, Asset ────────────────────────────────────────────────────
import {OracleDataBridge} from "../src/oracle/contracts/OracleDataBridge.sol";
import {Treasury} from "../src/treasury/contracts/Treasury.sol";
import {AssetFactory} from "../src/asset/contracts/AssetFactory.sol";
import {BaseAssetToken} from "../src/asset/contracts/BaseAssetToken.sol";

/// @title DeployTestnet
/// @notice Full platform deployment script for Lisk Sepolia testnet.
///         Deploys every contract in the correct dependency order and
///         leaves the platform in a fully operational state with one
///         sample asset token ready for investor interaction.

contract DeployTestnet is Script {

    // DiamondLoupeFacet
    bytes4 private constant SEL_FACETS =
        IDiamondLoupe.facets.selector;
    bytes4 private constant SEL_FACET_FUNCTION_SELECTORS =
        IDiamondLoupe.facetFunctionSelectors.selector;
    bytes4 private constant SEL_FACET_ADDRESSES =
        IDiamondLoupe.facetAddresses.selector;
    bytes4 private constant SEL_FACET_ADDRESS =
        IDiamondLoupe.facetAddress.selector;
    bytes4 private constant SEL_SUPPORTS_INTERFACE =
        bytes4(keccak256("supportsInterface(bytes4)"));

    // OwnershipFacet
    bytes4 private constant SEL_TRANSFER_OWNERSHIP =
        bytes4(keccak256("transferOwnership(address)"));
    bytes4 private constant SEL_OWNER =
        bytes4(keccak256("owner()"));

    bytes4 private constant SEL_ADD_TO_WHITELIST =
        bytes4(keccak256("addToWhitelist(address)"));
    bytes4 private constant SEL_REMOVE_FROM_WHITELIST =
        bytes4(keccak256("removeFromWhitelist(address)"));
    bytes4 private constant SEL_BATCH_ADD_TO_WHITELIST =
        bytes4(keccak256("batchAddToWhitelist(address[])"));
    bytes4 private constant SEL_SET_INVESTOR_STATUS =
        bytes4(keccak256("setInvestorStatus(address,bool)"));
    bytes4 private constant SEL_SET_INVESTOR_DATA =
        bytes4(keccak256(
            "setInvestorData(address,(bool,bool,bool,uint64,bytes32,bytes32))"
        ));
    bytes4 private constant SEL_BATCH_SET_INVESTOR_DATA =
        bytes4(keccak256(
            "batchSetInvestorData(address[],(bool,bool,bool,uint64,bytes32,bytes32)[])"
        ));
    bytes4 private constant SEL_GET_INVESTOR_DATA =
        bytes4(keccak256("getInvestorData(address)"));
    bytes4 private constant SEL_IS_WHITELISTED =
        bytes4(keccak256("isWhitelisted(address)"));
    bytes4 private constant SEL_IS_ACCREDITED =
        bytes4(keccak256("isAccredited(address)"));

    // ComplianceRulesFacet — 5 selectors
    bytes4 private constant SEL_SET_ASSET_RULES =
        bytes4(keccak256(
            "setAssetRules(address,(bool,bool,bool,bool,uint256,uint256))"
        ));
    bytes4 private constant SEL_SET_JURISDICTION_RESTRICTION =
        bytes4(keccak256("setJurisdictionRestriction(address,bytes32,bool)"));
    bytes4 private constant SEL_SET_ACCESS_CONTROL =
        bytes4(keccak256("setAccessControl(address)"));
    bytes4 private constant SEL_GET_ASSET_RULES =
        bytes4(keccak256("getAssetRules(address)"));
    bytes4 private constant SEL_IS_JURISDICTION_RESTRICTED =
        bytes4(keccak256("isJurisdictionRestricted(address,bytes32)"));

    bytes4 private constant SEL_CAN_TRANSFER =
        bytes4(keccak256(
            "canTransfer(address,address,address,uint256,uint256)"
        ));
    bytes4 private constant SEL_CAN_SUBSCRIBE =
        bytes4(keccak256(
            "canSubscribe(address,address,uint256,uint256)"
        ));
    bytes4 private constant SEL_CAN_REDEEM =
        bytes4(keccak256("canRedeem(address,address,uint256)"));

    // ── Main deployment ───────────────────────────────────────────────────────

    function run() external {
        uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
        address deployer = vm.addr(deployerPrivateKey);

        vm.startBroadcast(deployerPrivateKey);

        console2.log("================================================");
        console2.log("  Guardrail Platform — Testnet Deployment");
        console2.log("================================================");
        console2.log("Deployer:", deployer);
        console2.log("");

        AccessControl accessControl = new AccessControl(
            deployer,   // defaultAdmin  — holds DEFAULT_ADMIN_ROLE (use MultiSig on mainnet)
            deployer    // operationalAdmin — holds ADMIN_ROLE (use separate op wallet on mainnet)
        );
        console2.log("[1/8] AccessControl deployed at:", address(accessControl));

        accessControl.grantRole(accessControl.ISSUER_ROLE(),     deployer);
        accessControl.grantRole(accessControl.COMPLIANCE_ROLE(), deployer);
        accessControl.grantRole(accessControl.TREASURY_ROLE(),   deployer);
        accessControl.grantRole(accessControl.ORACLE_ROLE(),     deployer);
        accessControl.grantRole(accessControl.PAUSER_ROLE(),     deployer);

        // ─────────────────────────────────────────────────────────────────────
        // STEP 2 — MockUSDC (testnet payment token only)
        // ─────────────────────────────────────────────────────────────────────
        MockUSDC usdc = new MockUSDC();
        console2.log("[2/8] MockUSDC deployed at:", address(usdc));

        // ─────────────────────────────────────────────────────────────────────
        // STEP 3 — ComplianceDiamond (replaces ComplianceRegistry)
        // FIX [Critical 6]: ComplianceRegistry no longer exists.
        //                   The ComplianceDiamond is the permanent compliance
        //                   address. All other contracts store this address.
        //                   Facets behind it can be upgraded without changing
        //                   the stored address in any consumer contract.
        // ─────────────────────────────────────────────────────────────────────
        console2.log("");
        console2.log("[3/8] Deploying ComplianceDiamond system...");

        // 3a — Bootstrap facet (registers only the diamondCut selector)
        DiamondCutFacet cutFacet = new DiamondCutFacet();
        console2.log("      DiamondCutFacet:          ", address(cutFacet));

        // 3b — The diamond proxy itself — this is the permanent address
        //      The deployer is diamond owner for testnet.
        //      On mainnet pass the MultiSigAdmin address instead of deployer.
        ComplianceDiamond diamond = new ComplianceDiamond(
            deployer,           // diamond owner — can call diamondCut
            address(cutFacet)   // bootstrap facet
        );
        console2.log("      ComplianceDiamond (proxy): ", address(diamond));

        // 3c — Deploy all remaining facet implementations
        DiamondLoupeFacet  loupeFacet     = new DiamondLoupeFacet();
        OwnershipFacet     ownershipFacet = new OwnershipFacet();
        ComplianceWhitelistFacet whitelist = new ComplianceWhitelistFacet();
        ComplianceRulesFacet     rules     = new ComplianceRulesFacet();
        ComplianceCheckFacet     checker   = new ComplianceCheckFacet();
        ComplianceInit           cInit     = new ComplianceInit();
        console2.log("      DiamondLoupeFacet:         ", address(loupeFacet));
        console2.log("      OwnershipFacet:            ", address(ownershipFacet));
        console2.log("      ComplianceWhitelistFacet:  ", address(whitelist));
        console2.log("      ComplianceRulesFacet:      ", address(rules));
        console2.log("      ComplianceCheckFacet:      ", address(checker));
        console2.log("      ComplianceInit:            ", address(cInit));

        // 3d — Build the FacetCut array
        //      Each element maps a set of 4-byte selectors to a facet address.
        //      The diamond's fallback uses this mapping to route every call.
        IDiamondCut.FacetCut[] memory cut = _buildFacetCuts(
            address(loupeFacet),
            address(ownershipFacet),
            address(whitelist),
            address(rules),
            address(checker)
        );

        // 3e — Execute the initial diamondCut
        //      This atomically:
        //        (a) registers all selectors in the diamond routing table
        //        (b) delegatecalls ComplianceInit.initialize() to write the
        //            AccessControl address into diamond storage
        IDiamondCut(address(diamond)).diamondCut(
            cut,
            address(cInit),
            abi.encodeWithSelector(
                ComplianceInit.initialize.selector,
                address(accessControl)
            )
        );
        console2.log("      diamondCut executed — all facets registered");
        console2.log("      Storage initialised with AccessControl address");

        // ─────────────────────────────────────────────────────────────────────
        // STEP 4 — Treasury
        // ─────────────────────────────────────────────────────────────────────
        Treasury treasury = new Treasury(
            address(usdc),
            address(accessControl)
        );
        console2.log("");
        console2.log("[4/8] Treasury deployed at:", address(treasury));

        // ─────────────────────────────────────────────────────────────────────
        // STEP 5 — OracleDataBridge
        // ─────────────────────────────────────────────────────────────────────
        OracleDataBridge oracle = new OracleDataBridge(address(accessControl));
        // Grant ORACLE_ROLE to the oracle contract itself so it can call
        // setPricing on asset tokens after submitting a valuation
        accessControl.grantRole(accessControl.ORACLE_ROLE(), address(oracle));
        console2.log("[5/8] OracleDataBridge deployed at:", address(oracle));

        // ─────────────────────────────────────────────────────────────────────
        // STEP 6 — AssetFactory
        // ─────────────────────────────────────────────────────────────────────
        AssetFactory factory = new AssetFactory(
            address(accessControl),
            address(diamond),    // ← ComplianceDiamond replaces ComplianceRegistry
            address(treasury)
        );
        console2.log("[6/8] AssetFactory deployed at:", address(factory));

        // ─────────────────────────────────────────────────────────────────────
        // STEP 7 — Register asset type and deploy sample asset token
        // ─────────────────────────────────────────────────────────────────────
        bytes32 realEstateType = keccak256("REAL_ESTATE");
        factory.registerAssetType(realEstateType, "Real Estate", address(0));

        address tokenAddress = factory.createAsset(
            1,               // proposalId
            realEstateType,  // assetTypeId
            "Property Token 1",
            "PROP1",
            1_000_000 * 1e18, // maxSupply — 1 million tokens
            abi.encode(
                AssetFactory.AssetCreationConfig({
                    subscriptionPrice:         1e6,     // 1.00 USDC per token
                    redemptionPrice:           1e6,     // 1.00 USDC per token
                    selfServicePurchaseEnabled: true,
                    metadataHash:              bytes32(0)
                })
            )
        );
        console2.log("[7/8] Sample asset token (PROP1) deployed at:", tokenAddress);

        // ─────────────────────────────────────────────────────────────────────
        // STEP 8 — Configure compliance rules for PROP1 via the diamond
        //          The call routes through the diamond fallback to
        //          ComplianceRulesFacet.setAssetRules() transparently.
        //          Without this step all investor interactions with PROP1
        //          will revert because the default zero-value rules block
        //          every operation.
        // ─────────────────────────────────────────────────────────────────────
        ComplianceRulesFacet(address(diamond)).setAssetRules(
            tokenAddress,
            LibComplianceStorage.AssetRules({
                transfersEnabled:      true,
                subscriptionsEnabled:  true,
                redemptionsEnabled:    true,
                requiresAccreditation: false,
                minInvestment:         1e18,            // min 1 token per purchase
                maxInvestorBalance:    250_000 * 1e18   // max 250k tokens per investor
            })
        );
        console2.log("[8/8] Compliance rules configured for PROP1");

        vm.stopBroadcast();

        // ─────────────────────────────────────────────────────────────────────
        // Deployment Summary
        // ─────────────────────────────────────────────────────────────────────
        console2.log("");
        console2.log("================================================");
        console2.log("  Deployment Summary");
        console2.log("================================================");
        console2.log("AccessControl:            ", address(accessControl));
        console2.log("MockUSDC:                 ", address(usdc));
        console2.log("ComplianceDiamond:        ", address(diamond));
        console2.log("  DiamondCutFacet:        ", address(cutFacet));
        console2.log("  DiamondLoupeFacet:      ", address(loupeFacet));
        console2.log("  OwnershipFacet:         ", address(ownershipFacet));
        console2.log("  ComplianceWhitelistFacet:", address(whitelist));
        console2.log("  ComplianceRulesFacet:   ", address(rules));
        console2.log("  ComplianceCheckFacet:   ", address(checker));
        console2.log("Treasury:                 ", address(treasury));
        console2.log("OracleDataBridge:         ", address(oracle));
        console2.log("AssetFactory:             ", address(factory));
        console2.log("Sample Asset (PROP1):     ", tokenAddress);
        console2.log("================================================");
        console2.log("");
        console2.log("IMPORTANT — Testnet notes:");
        console2.log("  deployer holds all roles — replace with separate");
        console2.log("  wallets before mainnet deployment.");
        console2.log("  diamond owner is deployer — replace with MultiSigAdmin");
        console2.log("  address on mainnet.");
    }

    // ── Internal helper — builds the 5-element FacetCut array ────────────────

    /// @dev Extracted to a separate function to keep run() readable.
    ///      Each FacetCut maps a set of function selectors to a deployed
    ///      facet contract address using the Add action.
    function _buildFacetCuts(
        address loupeFacet,
        address ownershipFacet,
        address whitelistFacet,
        address rulesFacet,
        address checkFacet
    ) internal view returns (IDiamondCut.FacetCut[] memory cut) {
        cut = new IDiamondCut.FacetCut[](5);

        // ── DiamondLoupeFacet (5 selectors) ───────────────────────────────────
        bytes4[] memory loupeSelectors = new bytes4[](5);
        loupeSelectors[0] = SEL_FACETS;
        loupeSelectors[1] = SEL_FACET_FUNCTION_SELECTORS;
        loupeSelectors[2] = SEL_FACET_ADDRESSES;
        loupeSelectors[3] = SEL_FACET_ADDRESS;
        loupeSelectors[4] = SEL_SUPPORTS_INTERFACE;
        cut[0] = IDiamondCut.FacetCut({
            facetAddress:      loupeFacet,
            action:            IDiamondCut.FacetCutAction.Add,
            functionSelectors: loupeSelectors
        });

        // ── OwnershipFacet (2 selectors) ──────────────────────────────────────
        bytes4[] memory ownershipSelectors = new bytes4[](2);
        ownershipSelectors[0] = SEL_TRANSFER_OWNERSHIP;
        ownershipSelectors[1] = SEL_OWNER;
        cut[1] = IDiamondCut.FacetCut({
            facetAddress:      ownershipFacet,
            action:            IDiamondCut.FacetCutAction.Add,
            functionSelectors: ownershipSelectors
        });

        // ── ComplianceWhitelistFacet (9 selectors) ────────────────────────────
        // FIX [High 4]: isWhitelisted selector now registered (index 7)
        // FIX [High 5]: isAccredited selector now registered  (index 8)
        bytes4[] memory whitelistSelectors = new bytes4[](9);
        whitelistSelectors[0] = SEL_ADD_TO_WHITELIST;
        whitelistSelectors[1] = SEL_REMOVE_FROM_WHITELIST;
        whitelistSelectors[2] = SEL_BATCH_ADD_TO_WHITELIST;
        whitelistSelectors[3] = SEL_SET_INVESTOR_STATUS;
        whitelistSelectors[4] = SEL_SET_INVESTOR_DATA;
        whitelistSelectors[5] = SEL_BATCH_SET_INVESTOR_DATA;
        whitelistSelectors[6] = SEL_GET_INVESTOR_DATA;
        whitelistSelectors[7] = SEL_IS_WHITELISTED;
        whitelistSelectors[8] = SEL_IS_ACCREDITED;
        cut[2] = IDiamondCut.FacetCut({
            facetAddress:      whitelistFacet,
            action:            IDiamondCut.FacetCutAction.Add,
            functionSelectors: whitelistSelectors
        });

        // ── ComplianceRulesFacet (5 selectors) ────────────────────────────────
        bytes4[] memory rulesSelectors = new bytes4[](5);
        rulesSelectors[0] = SEL_SET_ASSET_RULES;
        rulesSelectors[1] = SEL_SET_JURISDICTION_RESTRICTION;
        rulesSelectors[2] = SEL_SET_ACCESS_CONTROL;
        rulesSelectors[3] = SEL_GET_ASSET_RULES;
        rulesSelectors[4] = SEL_IS_JURISDICTION_RESTRICTED;
        cut[3] = IDiamondCut.FacetCut({
            facetAddress:      rulesFacet,
            action:            IDiamondCut.FacetCutAction.Add,
            functionSelectors: rulesSelectors
        });

        // ── ComplianceCheckFacet (3 selectors) ────────────────────────────────
        // FIX [Critical 11]: canSubscribe selector uses 4-parameter signature.
        //                    Old selector was canSubscribe(address,address,uint256)
        //                    Correct selector is canSubscribe(address,address,uint256,uint256)
        //                    This matches the ICompliance interface declaration and
        //                    the fixed ComplianceCheckFacet implementation.
        //                    Without this fix, every purchase attempt would revert
        //                    with "ComplianceDiamond: Function does not exist".
        bytes4[] memory checkSelectors = new bytes4[](3);
        checkSelectors[0] = SEL_CAN_TRANSFER;
        checkSelectors[1] = SEL_CAN_SUBSCRIBE;  // 4-param signature
        checkSelectors[2] = SEL_CAN_REDEEM;
        cut[4] = IDiamondCut.FacetCut({
            facetAddress:      checkFacet,
            action:            IDiamondCut.FacetCutAction.Add,
            functionSelectors: checkSelectors
        });
    }
}
