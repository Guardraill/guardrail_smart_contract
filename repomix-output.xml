// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {LibComplianceStorage} from "../libraries/LibComplianceStorage.sol";

/// @title ComplianceCheckFacet
/// @notice Facet 3 of 3 — the read-only compliance gate.
///         Contains canTransfer, canSubscribe and canRedeem — the three
///         functions called by BaseAssetToken before every token movement.
///         This is the most performance-critical facet — it is called on
///         every purchase, transfer and redemption.
///
/// @dev FACET RESPONSIBILITY BOUNDARY
///      This facet is PURE VIEW — it writes no state. It only reads
///      from LibComplianceStorage and returns a (bool, bytes32) result.
///      Keeping it separate means it can be upgraded independently when
///      compliance logic changes without touching whitelist or rule management.
///

contract ComplianceCheckFacet {

    // ─── Pre-computed reason codes ─────────────────────────────────────────────
    // Stored as constants to save gas on every check call — no keccak at runtime.
    bytes32 private constant TRANSFERS_DISABLED =
        keccak256("TRANSFERS_DISABLED");
    bytes32 private constant SUBSCRIPTIONS_DISABLED =
        keccak256("SUBSCRIPTIONS_DISABLED");
    bytes32 private constant REDEMPTIONS_DISABLED =
        keccak256("REDEMPTIONS_DISABLED");
    bytes32 private constant SENDER_NOT_ELIGIBLE =
        keccak256("SENDER_NOT_ELIGIBLE");
    bytes32 private constant RECIPIENT_NOT_ELIGIBLE =
        keccak256("RECIPIENT_NOT_ELIGIBLE");
    bytes32 private constant SENDER_JURISDICTION_RESTRICTED =
        keccak256("SENDER_JURISDICTION_RESTRICTED");
    bytes32 private constant RECIPIENT_JURISDICTION_RESTRICTED =
        keccak256("RECIPIENT_JURISDICTION_RESTRICTED");
    bytes32 private constant ACCREDITATION_REQUIRED =
        keccak256("ACCREDITATION_REQUIRED");
    bytes32 private constant BELOW_MIN_INVESTMENT =
        keccak256("BELOW_MIN_INVESTMENT");
    bytes32 private constant MAX_BALANCE_EXCEEDED =
        keccak256("MAX_BALANCE_EXCEEDED");
    bytes32 private constant INVESTOR_NOT_ELIGIBLE =
        keccak256("INVESTOR_NOT_ELIGIBLE");
    bytes32 private constant JURISDICTION_RESTRICTED =
        keccak256("JURISDICTION_RESTRICTED");

    function canTransfer(
        address asset,
        address from,
        address to,
        uint256 amount,
        uint256 receivingBalance
    ) external view returns (bool isValid, bytes32 reason) {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        LibComplianceStorage.AssetRules storage rules = l.assetRules[asset];

        // 1. Asset-level transfer switch
        if (!rules.transfersEnabled) {
            return (false, TRANSFERS_DISABLED);
        }

        // 2. Sender checks — skip for mints (from == address(0))
        if (from != address(0)) {
            LibComplianceStorage.InvestorData storage senderData =
                l.investors[from];
            if (!_isInvestorActive(senderData)) {
                return (false, SENDER_NOT_ELIGIBLE);
            }
            if (l.restrictedJurisdictions[asset][senderData.jurisdiction]) {
                return (false, SENDER_JURISDICTION_RESTRICTED);
            }
        }

        // 3. Recipient checks — skip for burns (to == address(0))
        if (to != address(0)) {
            LibComplianceStorage.InvestorData storage recipientData =
                l.investors[to];
            if (!_isInvestorActive(recipientData)) {
                return (false, RECIPIENT_NOT_ELIGIBLE);
            }
            if (l.restrictedJurisdictions[asset][recipientData.jurisdiction]) {
                return (false, RECIPIENT_JURISDICTION_RESTRICTED);
            }

            // 4. Accreditation gate
            if (rules.requiresAccreditation && !recipientData.isAccredited) {
                return (false, ACCREDITATION_REQUIRED);
            }

            // 5. Minimum investment check — only for mints (purchases)
            if (from == address(0) && rules.minInvestment > 0) {
                if (amount < rules.minInvestment) {
                    return (false, BELOW_MIN_INVESTMENT);
                }
            }

            // 6. Maximum balance check
            if (rules.maxInvestorBalance > 0) {
                if (receivingBalance + amount > rules.maxInvestorBalance) {
                    return (false, MAX_BALANCE_EXCEEDED);
                }
            }
        }

        return (true, bytes32(0));
    }

    function canSubscribe(
        address asset,
        address investor,
        uint256 amount,
        uint256 resultingBalance 
    ) external view returns (bool isValid, bytes32 reason) {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        LibComplianceStorage.AssetRules storage rules = l.assetRules[asset];

        // 1. Asset-level subscription switch
        if (!rules.subscriptionsEnabled) {
            return (false, SUBSCRIPTIONS_DISABLED);
        }

        // 2. Investor active check
        LibComplianceStorage.InvestorData storage investorData =
            l.investors[investor];
        if (!_isInvestorActive(investorData)) {
            return (false, INVESTOR_NOT_ELIGIBLE);
        }

        // 3. Jurisdiction check
        if (l.restrictedJurisdictions[asset][investorData.jurisdiction]) {
            return (false, JURISDICTION_RESTRICTED);
        }

        // 4. Accreditation gate
        if (rules.requiresAccreditation && !investorData.isAccredited) {
            return (false, ACCREDITATION_REQUIRED);
        }

        // 5. Minimum investment
        if (rules.minInvestment > 0 && amount < rules.minInvestment) {
            return (false, BELOW_MIN_INVESTMENT);
        }

        return (true, bytes32(0));
    }

    /// @notice Check whether an investor may redeem (request redemption of) an asset.
    ///         Called by BaseAssetToken.redeem() before locking tokens.
    ///
    /// @param asset    The BaseAssetToken contract address
    /// @param investor The redeeming investor's wallet address
    /// @param amount   Token amount being redeemed (wei)
    /// @return isValid true if the redemption is compliant
    /// @return reason  bytes32 reason code if isValid is false, else bytes32(0)
    function canRedeem(
        address asset,
        address investor,
        uint256 amount
    ) external view returns (bool isValid, bytes32 reason) {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        LibComplianceStorage.AssetRules storage rules = l.assetRules[asset];

        // Silence unused variable warning — amount kept for future rule extensions
        // (e.g. minimum redemption amount) without changing the function signature
        amount;

        // 1. Asset-level redemption switch
        if (!rules.redemptionsEnabled) {
            return (false, REDEMPTIONS_DISABLED);
        }

        // 2. Investor active check — frozen investors cannot redeem
        LibComplianceStorage.InvestorData storage investorData =
            l.investors[investor];
        if (!_isInvestorActive(investorData)) {
            return (false, INVESTOR_NOT_ELIGIBLE);
        }

        // 3. Jurisdiction check
        if (l.restrictedJurisdictions[asset][investorData.jurisdiction]) {
            return (false, JURISDICTION_RESTRICTED);
        }

        return (true, bytes32(0));
    }

    // ─── Internal Helpers ─────────────────────────────────────────────────────

    /// @dev An investor is active if: verified AND not frozen AND KYC not expired.
    ///      validUntil == 0 is a special sentinel meaning no expiry.
    function _isInvestorActive(
        LibComplianceStorage.InvestorData storage data
    ) internal view returns (bool) {
        if (!data.isVerified || data.isFrozen) return false;
        return data.validUntil == 0 || data.validUntil >= block.timestamp;
    }
}
</file>

<file path="src/compliance/facets/ComplianceRulesFacet.sol">
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {LibComplianceStorage} from "../libraries/LibComplianceStorage.sol";
import {IAccessControl} from "../../admin/interfaces/IAccessControl.sol";
import {Roles} from "../../admin/libraries/Roles.sol";

/// @title ComplianceRulesFacet
/// @notice Facet 2 of 3 — manages per-asset compliance rule sets and
///         jurisdiction restrictions. Every asset token deployed by
///         AssetFactory must have its rules configured here before any
///         investor can interact with it.
///
/// @dev FACET RESPONSIBILITY BOUNDARY
///      This facet owns: setAssetRules, getAssetRules,
///      setJurisdictionRestriction, isJurisdictionRestricted,
///      setAccessControl.
///
///      WHY A SEPARATE FACET FROM WHITELIST?
///      Investor management (whitelist) and asset configuration (rules)
///      are distinct operational concerns. Separating them means:
///        1. The compliance officer role can manage investors
///        2. The admin role manages asset-level configuration
///        3. Each facet can be upgraded independently
///        4. New asset types can add new rule fields without touching
///           the investor management logic
contract ComplianceRulesFacet {

    // ─── Events ───────────────────────────────────────────────────────────────
    event AssetRulesSet(address indexed asset, uint256 timestamp);
    event JurisdictionRestrictionUpdated(
        address indexed asset,
        bytes32 indexed jurisdiction,
        bool restricted,
        uint256 timestamp
    );
    event AccessControlUpdated(address indexed newAccessControl, uint256 timestamp);

    // ─── Errors ───────────────────────────────────────────────────────────────
    error Unauthorized();
    error InvalidAsset();
    error InvalidAddress();

    // ─── Modifiers ────────────────────────────────────────────────────────────

    modifier onlyAdmin() {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        IAccessControl ac = IAccessControl(l.accessControl);
        if (!ac.hasRole(Roles.ADMIN_ROLE, msg.sender)) revert Unauthorized();
        _;
    }

    modifier onlyComplianceOrAdmin() {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        IAccessControl ac = IAccessControl(l.accessControl);
        if (
            !ac.hasRole(Roles.COMPLIANCE_ROLE, msg.sender) &&
            !ac.hasRole(Roles.ADMIN_ROLE, msg.sender)
        ) revert Unauthorized();
        _;
    }

    // ─── Write Functions ──────────────────────────────────────────────────────

    /// @notice Configure the compliance rules for a specific asset token.
    ///         Must be called for every newly deployed asset before investors
    ///         can interact — default zero-value rules block all operations.
    /// @param asset   Address of the BaseAssetToken to configure
    /// @param rules   AssetRules struct with the compliance configuration:
    ///                - transfersEnabled      master switch for secondary market
    ///                - subscriptionsEnabled  master switch for purchases
    ///                - redemptionsEnabled    master switch for redemptions
    ///                - requiresAccreditation gates to accredited investors only
    ///                - minInvestment         minimum token amount per purchase (wei)
    ///                - maxInvestorBalance    maximum tokens any wallet may hold (wei)
    function setAssetRules(
        address asset,
        LibComplianceStorage.AssetRules calldata rules
    ) external onlyComplianceOrAdmin {
        if (asset == address(0)) revert InvalidAsset();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.assetRules[asset] = rules;
        emit AssetRulesSet(asset, block.timestamp);
    }

    /// @notice Restrict or unrestrict a jurisdiction for a specific asset.
    ///         When restricted=true, investors from that jurisdiction cannot
    ///         subscribe, transfer, or receive that asset's tokens.
    ///
    ///         Common jurisdiction codes (keccak256 of ISO 3166-1 alpha-2):
    ///           keccak256("NG") = Nigeria
    ///           keccak256("US") = United States
    ///           keccak256("KP") = North Korea (always restrict)
    ///           keccak256("IR") = Iran (always restrict)
    ///
    /// @param asset        Address of the BaseAssetToken
    /// @param jurisdiction bytes32 jurisdiction identifier
    /// @param restricted   true to block, false to unblock
    function setJurisdictionRestriction(
        address asset,
        bytes32 jurisdiction,
        bool restricted
    ) external onlyComplianceOrAdmin {
        if (asset == address(0)) revert InvalidAsset();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.restrictedJurisdictions[asset][jurisdiction] = restricted;
        emit JurisdictionRestrictionUpdated(
            asset, jurisdiction, restricted, block.timestamp
        );
    }

    /// @notice Update the AccessControl contract address.
    ///         Used when migrating to a new AccessControl deployment.
    ///         Can only be called by the diamond owner via diamondCut
    ///         or by a current admin — chicken-and-egg is avoided because
    ///         the old accessControl is still valid at the time of the call.
    function setAccessControl(address newAccessControl)
        external
        onlyAdmin
    {
        if (newAccessControl == address(0)) revert InvalidAddress();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.accessControl = newAccessControl;
        emit AccessControlUpdated(newAccessControl, block.timestamp);
    }

    // ─── View Functions ───────────────────────────────────────────────────────

    /// @notice Returns the full asset rules configuration for a given asset.
    function getAssetRules(address asset)
        external
        view
        returns (LibComplianceStorage.AssetRules memory)
    {
        return LibComplianceStorage.layout().assetRules[asset];
    }

    /// @notice Returns true if a jurisdiction is restricted for a given asset.
    function isJurisdictionRestricted(
        address asset,
        bytes32 jurisdiction
    ) external view returns (bool) {
        return LibComplianceStorage.layout().restrictedJurisdictions[asset][jurisdiction];
    }

    /// @notice Returns the current AccessControl contract address.
    function getAccessControl() external view returns (address) {
        return LibComplianceStorage.layout().accessControl;
    }
}
</file>

<file path="src/compliance/facets/ComplianceWhitelistFacet.sol">
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {LibComplianceStorage} from "../libraries/LibComplianceStorage.sol";
import {IAccessControl} from "../../admin/interfaces/IAccessControl.sol";
import {Roles} from "../../admin/libraries/Roles.sol";

/// @title ComplianceWhitelistFacet
/// @notice Facet 1 of 3 — manages the KYC/AML whitelist of investors.
///         Handles all operations that create, update or remove investor
///         profiles from the compliance registry.
///
/// @dev FACET RESPONSIBILITY BOUNDARY
///      This facet owns: addToWhitelist, removeFromWhitelist,
///      batchAddToWhitelist, setInvestorStatus, setInvestorData,
///      batchSetInvestorData, getInvestorData.
///
///      It does NOT own: asset rules, jurisdiction restrictions, or
///      transfer/subscription/redemption checks. Those belong to
///      ComplianceRulesFacet and ComplianceCheckFacet respectively.
///
/// @dev ACCESS CONTROL
///      All state-mutating functions require COMPLIANCE_ROLE or ADMIN_ROLE.
///      The role check reads the accessControl address stored in
///      LibComplianceStorage.layout().accessControl — set during initialization.
///      The diamond itself holds no privileged role — all authority flows
///      through the platform's AccessControl contract.
contract ComplianceWhitelistFacet {

    // ─── Events ───────────────────────────────────────────────────────────────
    event InvestorWhitelisted(address indexed investor, uint256 timestamp);
    event InvestorRemovedFromWhitelist(address indexed investor, uint256 timestamp);
    event InvestorDataUpdated(address indexed investor, uint256 timestamp);
    event BatchWhitelistProcessed(uint256 count, uint256 timestamp);

    // ─── Errors ───────────────────────────────────────────────────────────────
    error Unauthorized();
    error InvalidInvestor();
    error BatchLengthMismatch();

    // ─── Modifiers ────────────────────────────────────────────────────────────

    modifier onlyComplianceOrAdmin() {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        IAccessControl ac = IAccessControl(l.accessControl);
        if (
            !ac.hasRole(Roles.COMPLIANCE_ROLE, msg.sender) &&
            !ac.hasRole(Roles.ADMIN_ROLE, msg.sender)
        ) revert Unauthorized();
        _;
    }

    // ─── Write Functions ──────────────────────────────────────────────────────

    /// @notice Whitelist a single investor — sets isVerified=true, isFrozen=false.
    /// @dev    Does not set jurisdiction, accreditation or expiry.
    ///         Use setInvestorData for a complete profile setup.
    function addToWhitelist(address investor)
        external
        onlyComplianceOrAdmin
    {
        if (investor == address(0)) revert InvalidInvestor();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.investors[investor].isVerified = true;
        l.investors[investor].isFrozen = false;
        emit InvestorWhitelisted(investor, block.timestamp);
    }

    /// @notice Remove an investor from the whitelist — sets isVerified=false.
    ///         Immediately blocks the investor from all platform activity.
    function removeFromWhitelist(address investor)
        external
        onlyComplianceOrAdmin
    {
        if (investor == address(0)) revert InvalidInvestor();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.investors[investor].isVerified = false;
        emit InvestorRemovedFromWhitelist(investor, block.timestamp);
    }

    /// @notice Whitelist multiple investors in a single transaction.
    ///         Gas-efficient for onboarding large cohorts.
    function batchAddToWhitelist(address[] calldata investors)
        external
        onlyComplianceOrAdmin
    {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        for (uint256 i = 0; i < investors.length; i++) {
            if (investors[i] == address(0)) revert InvalidInvestor();
            l.investors[investors[i]].isVerified = true;
            l.investors[investors[i]].isFrozen = false;
        }
        emit BatchWhitelistProcessed(investors.length, block.timestamp);
    }

    /// @notice Update only the accreditation status of an investor.
    ///         Used when the off-chain KYC provider returns an accreditation result.
    function setInvestorStatus(address investor, bool investorIsAccredited)
        external
        onlyComplianceOrAdmin
    {
        if (investor == address(0)) revert InvalidInvestor();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.investors[investor].isAccredited = investorIsAccredited;
        emit InvestorDataUpdated(investor, block.timestamp);
    }

    /// @notice Set the complete data profile for a single investor.
    ///         This is the preferred function for full KYC onboarding —
    ///         it sets all fields in one transaction.
    /// @param investor  The investor wallet address
    /// @param data      Full InvestorData struct with all fields populated
    function setInvestorData(
        address investor,
        LibComplianceStorage.InvestorData calldata data
    ) external onlyComplianceOrAdmin {
        if (investor == address(0)) revert InvalidInvestor();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        l.investors[investor] = data;
        emit InvestorDataUpdated(investor, block.timestamp);
    }

    /// @notice Set investor data for multiple investors in one transaction.
    ///         Both arrays must have identical lengths.
    function batchSetInvestorData(
        address[] calldata investors,
        LibComplianceStorage.InvestorData[] calldata data
    ) external onlyComplianceOrAdmin {
        if (investors.length != data.length) revert BatchLengthMismatch();
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
        for (uint256 i = 0; i < investors.length; i++) {
            if (investors[i] == address(0)) revert InvalidInvestor();
            l.investors[investors[i]] = data[i];
        }
        emit BatchWhitelistProcessed(investors.length, block.timestamp);
    }

    // ─── View Functions ───────────────────────────────────────────────────────

    /// @notice Returns the full KYC/AML profile for a given investor.
    function getInvestorData(address investor)
        external
        view
        returns (LibComplianceStorage.InvestorData memory)
    {
        return LibComplianceStorage.layout().investors[investor];
    }

    /// @notice Returns true if the investor is active — verified, not frozen,
    ///         and KYC has not expired.
    function isInvestorActive(address investor) external view returns (bool) {
        return _isInvestorActive(LibComplianceStorage.layout().investors[investor]);
    }

    // ─── Internal Helpers ─────────────────────────────────────────────────────

    function _isInvestorActive(
        LibComplianceStorage.InvestorData memory data
    ) internal view returns (bool) {
        if (!data.isVerified || data.isFrozen) return false;
        return data.validUntil == 0 || data.validUntil >= block.timestamp;
    }

    function isWhitelisted(address investor) external view returns (bool) {
    LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();
    return _isInvestorActive(l.investors[investor]);
}



    function isAccredited(address investor) external view returns (bool) {
    return LibComplianceStorage.layout().investors[investor].isAccredited;
}
}
</file>

