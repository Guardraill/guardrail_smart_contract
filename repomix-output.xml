// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {LibDiamond} from "../libraries/LibDiamond.sol";
import {IDiamondCut} from "../interfaces/IDiamondCut.sol";
import {IDiamondLoupe} from "../interfaces/IDiamondLoupe.sol";
import {IERC165} from "../interfaces/IERC165.sol";

/// @title ComplianceDiamond
/// @notice The diamond proxy contract for the Guardrail compliance system.
///         This is the permanent on-chain address that all other contracts
///         (BaseAssetToken, Treasury, OracleDataBridge) call for compliance
///         checks. It never changes address — only the facets behind it change.
///

contract ComplianceDiamond {

    /// @param _contractOwner  Address that owns this diamond and can call diamondCut.
    ///                        In production this should be the MultiSigAdmin address
    ///                        so that all upgrades require multi-sig approval.
    /// @param _diamondCutFacet Address of the deployed DiamondCutFacet.
    ///                         Only the diamondCut selector is registered here —
    ///                         all other facets are added via a subsequent cut.
    constructor(
        address _contractOwner,
        address _diamondCutFacet
    ) payable {
        // Set the diamond owner in LibDiamond storage.
        // The owner is the only address authorised to call diamondCut.
        LibDiamond.setContractOwner(_contractOwner);

        // Bootstrap: register the single diamondCut function selector
        // pointing at the DiamondCutFacet. Every other facet is added
        // through this bootstrapped function in the deploy script.
        IDiamondCut.FacetCut[] memory cut = new IDiamondCut.FacetCut[](1);
        bytes4[] memory functionSelectors = new bytes4[](1);
        functionSelectors[0] = IDiamondCut.diamondCut.selector;
        cut[0] = IDiamondCut.FacetCut({
            facetAddress: _diamondCutFacet,
            action: IDiamondCut.FacetCutAction.Add,
            functionSelectors: functionSelectors
        });
        // address(0) init and empty calldata = no initializer on bootstrap
        LibDiamond.diamondCut(cut, address(0), "");
    }

    // ─── Fallback — the core diamond routing mechanism ────────────────────────

    /// @notice Routes all calls to the appropriate facet via delegatecall.
    ///         When ComplianceRegistry.canTransfer() is called on this address,
    ///         the fallback intercepts it, looks up which facet holds that
    ///         selector, and delegatecalls into that facet. The facet code
    ///         runs but reads and writes storage on THIS diamond contract.
    fallback() external payable {
        LibDiamond.DiamondStorage storage ds;
        bytes32 position = LibDiamond.DIAMOND_STORAGE_POSITION;
        assembly {
            ds.slot := position
        }
        address facet = ds.selectorToFacetAndPosition[msg.sig].facetAddress;
        require(facet != address(0), "ComplianceDiamond: Function does not exist");
        assembly {
            calldatacopy(0, 0, calldatasize())
            let result := delegatecall(gas(), facet, 0, calldatasize(), 0, 0)
            returndatacopy(0, 0, returndatasize())
            switch result
            case 0 { revert(0, returndatasize()) }
            default { return(0, returndatasize()) }
        }
    }

    receive() external payable {}
}
</file>

<file path="src/compliance/diamond/ComplianceInit.sol">
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.30;

import {LibComplianceStorage} from "../libraries/LibComplianceStorage.sol";
import {LibDiamond} from "../libraries/LibDiamond.sol";
import {IDiamondLoupe} from "../interfaces/IDiamondLoupe.sol";
import {IDiamondCut} from "../interfaces/IDiamondCut.sol";
import {IERC165} from "../interfaces/IERC165.sol";

/// @title ComplianceInit
/// @notice One-time initializer contract called via delegatecall during the
///         initial diamondCut that adds all three compliance facets.
///
/// @dev WHY A SEPARATE INIT CONTRACT?
///      In the diamond pattern, facets cannot have constructors for
///      initializing storage because they are deployed separately from
///      the proxy and their constructors run on themselves, not on the diamond.
///      Instead, initialization logic is put in a standalone contract and
///      called via delegatecall as part of a diamondCut operation.
///
///      The delegatecall means `address(this)` inside initialize() is the
///      diamond's address and all storage writes go to the diamond's storage —
///      exactly where LibComplianceStorage.layout() points.
///
/// @dev SECURITY
///      The `initialized` flag in LibComplianceStorage prevents this from
///      being called a second time. After the initial deployment cut, this
///      contract's purpose is complete and it holds no further authority.
contract ComplianceInit {

    error AlreadyInitialized();
    error InvalidAccessControl();

    /// @notice Initialize the compliance diamond storage.
    ///         Called exactly once via delegatecall from the diamond during
    ///         the deployment diamondCut.
    ///
    /// @param accessControl  Address of the platform's AccessControl contract.
    ///                       This is the only parameter needed at init time.
    ///                       All other state (investors, rules) is set post-deployment
    ///                       by compliance officers via the facet functions.
    function initialize(address accessControl) external {
        LibComplianceStorage.Layout storage l = LibComplianceStorage.layout();

        if (l.initialized) revert AlreadyInitialized();
        if (accessControl == address(0)) revert InvalidAccessControl();

        l.accessControl = accessControl;
        l.initialized = true;

        // Register ERC-165 interface support in LibDiamond storage
        // so that external tools can query what interfaces this diamond supports.
        LibDiamond.DiamondStorage storage ds = LibDiamond.diamondStorage();
        ds.supportedInterfaces[type(IERC165).interfaceId] = true;
        ds.supportedInterfaces[type(IDiamondCut).interfaceId] = true;
        ds.supportedInterfaces[type(IDiamondLoupe).interfaceId] = true;
    }
}
</file>

