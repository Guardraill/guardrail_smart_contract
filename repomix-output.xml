const testCommutative = (fn, lhs, rhs, expected, ...extra) =>
  Promise.all([
    expect(fn(lhs, rhs, ...extra)).to.eventually.deep.equal(expected),
    expect(fn(rhs, lhs, ...extra)).to.eventually.deep.equal(expected),
  ]);

