# RPC URLs
LISK_SEPOLIA_URL=https://rpc.sepolia-api.lisk.com

# Private keys (never commit real keys)
PRIVATE_KEY=your_private_key_here

# Optional multisig deployment / configuration
# If ADMIN_MULTISIG is set, the script uses that address as the diamond owner
# and AccessControl DEFAULT_ADMIN_ROLE holder.
ADMIN_MULTISIG=0x0000000000000000000000000000000000000000
OPERATIONAL_ADMIN=0x0000000000000000000000000000000000000000
MULTISIG_SIGNERS=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000
MULTISIG_QUORUM=2
MULTISIG_TIMELOCK=172800

# Optional post-deployment addresses
ASSET_TOKEN_ADDRESS=
COMPLIANCE_REGISTRY_ADDRESS=
ORACLE_DATA_BRIDGE_ADDRESS=
VAULT_TREASURY_ADDRESS=
ACCESS_CONTROL_ADDRESS=
